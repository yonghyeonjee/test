# ── 브라우저에 노출되는 값 (NEXT_PUBLIC_) ───────────────────
NEXT_PUBLIC_SUPABASE_URL=https://iabtlainrxzkwyhyqajl.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=https://jiwon.knowhow-it.com

# ── 서버에서만 읽히는 값. 절대 NEXT_PUBLIC_ 을 붙이지 말 것 ──
# Supabase > Settings > API > service_role
SUPABASE_SERVICE_KEY=

# 관리자 계정. 코드에 두지 않는다.
ADMIN_USER=
ADMIN_PASSWORD=
ADMIN_SECRET=

# ── 관리자 로그인 배경 영상 (선택) ─────────────────────────
# 비워두면 초록 그라데이션만 나온다. 영상이 없어도 화면은 완성돼 있다.
# Pexels 등에서 받은 .mp4 직접 주소를 넣고, 출처 표기가 필요한 곳이면
# CREDIT 도 함께 채운다.
NEXT_PUBLIC_LOGIN_VIDEO=
NEXT_PUBLIC_LOGIN_CREDIT=
NEXT_PUBLIC_LOGIN_CREDIT_URL=

# ── 캡차 (Cloudflare Turnstile, 무료) ──────────────────────
# 계정 만들기·불러오기에서 자동 가입을 막는다.
# 두 값이 없으면 캡차를 건너뛴다 — 운영에서는 반드시 넣을 것.
# dash.cloudflare.com > Turnstile 에서 사이트 추가 후 발급
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Google Tag Manager ────────────────────────────────────
# 비워두면 스크립트를 아예 넣지 않는다.
NEXT_PUBLIC_GTM_ID=GTM-WGBNM8PK

# ── 공공데이터포털 (data.go.kr) ────────────────────────────
# 전세자금대출 금리 정보 등 공공 API 호출에 쓴다.
# 비워두면 해당 화면이 안내 문구로 대체될 뿐, 사이트는 정상 동작한다.
# 반드시 Secret 으로 넣는다. NEXT_PUBLIC_ 을 붙이면 브라우저에 그대로 실린다.
DATA_GO_KR_KEY=

# ── 알리오 플러스 (alioplus.go.kr) ──────────────────────────
# 공공기관 사업·행사·시설 화면(/agency)에 쓴다. 공공데이터포털과 별개 키다.
# alioplus.go.kr 소셜 로그인 → Open API → API 발급. 활용정보마다 키가 따로
# 나오므로 종류별로 넣는다. 반드시 Secret.
ALIOPLUS_KEY_BUSINESS=    # 사업정보  → /agency
ALIOPLUS_KEY_EVENT=       # 행사정보  → /agency/events
ALIOPLUS_KEY_FACILITY=    # 시설정보  → /agency/facilities
ALIOPLUS_KEY_APBA=        # 기관정보  (지금은 화면 없음, 넣어 두면 됨)
# 키가 하나뿐이면 아래에 넣어도 된다. 종류별 변수가 없을 때만 쓴다.
ALIOPLUS_API_KEY=
