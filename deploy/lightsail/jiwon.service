# 나라지원 Next.js 서버(standalone). setup.sh 가 /etc/systemd/system/jiwon.service 로 깐다.
[Unit]
Description=narajiwon (Next.js standalone)
After=network-online.target
Wants=network-online.target

[Service]
User=jiwon
WorkingDirectory=/srv/jiwon/current
EnvironmentFile=/srv/jiwon/shared/.env
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
# 512MB 서버($5): 힙을 256MB 로 묶는다. 실측(동시 20개 요청 300번)은 80MB 안팎이었다.
# 380MB 를 넘으면 스왑으로 밀어내고, 450MB 에서 끊고 다시 띄운다.
ExecStart=/usr/bin/node --max-old-space-size=256 server.js
Restart=always
RestartSec=3
MemoryHigh=380M
MemoryMax=450M
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
