# 봇 막기(2026-10-14). deploy/lightsail/botguard.sh 가 /etc/fail2ban 에 올린다.
# 막으면 그 IP 는 80·443 에 아예 닿지 않는다(방화벽). 시간이 지나면 저절로 풀린다.
#
#  jiwon-flood       1분에 쪽·API 90번 넘게(초당 1.5회)        → 1시간
#  jiwon-flood-long  10분에 600번 넘게(초당 1회를 10분 내내)    → 6시간
#  jiwon-scan        10분에 스캐너 주소 3번                      → 하루
#
# 사람은 쪽을 1분에 열 번 넘게 열기 어렵다. 통신사 공유 IP(CGNAT) 뒤에 여러 사람이 있어도 이 사이트 규모로는 닿지 않는다.
# 너무 세면 maxretry 를 올린다. 지금 막힌 IP: sudo fail2ban-client status jiwon-flood
# 풀기: sudo fail2ban-client set jiwon-flood unbanip <IP>
#
# sshd 감옥은 끈다. 접속은 키로만 되고, GitHub Actions 배포가 잘못 막히면 서버에 못 들어간다.

# Cloudflare 대역은 절대 막지 않는다(2026-11-16). 앞단을 거치면 연결은 모두 Cloudflare 에서 온다 — 기록의 client_ip 는
# Caddy 가 CF-Connecting-IP 로 바꿔 두지만, 혹시 그 설정이 빠져도 Cloudflare 를 막아 사이트가 끊기는 일은 없게 한다.
# Cloudflare 를 거친 손님 IP 를 막아도 방화벽에는 닿지 않는다(연결은 Cloudflare 것). 그런 손님의 속도 제한은
# Cloudflare 쪽 규칙이 맡고, 여기서는 서버 IP 로 바로 오는 것만 실제로 막힌다. 목록은 Caddyfile 맨 위와 같다.
[DEFAULT]
ignoreip = 127.0.0.1/8 ::1 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
backend  = polling
port     = http,https
logpath  = /var/log/caddy/access.log

[sshd]
enabled = false

[jiwon-flood]
enabled  = true
filter   = jiwon-flood
findtime = 60
maxretry = 90
bantime  = 3600

[jiwon-flood-long]
enabled  = true
filter   = jiwon-flood
findtime = 600
maxretry = 600
bantime  = 21600

[jiwon-scan]
enabled  = true
filter   = jiwon-scan
findtime = 600
maxretry = 3
bantime  = 86400
