# Caddy: HTTPS 인증서를 스스로 받고 갱신한다. setup.sh 가 처음 깔고, 그 뒤로는 deploy_aws.yml 이
# 바뀐 파일을 /etc/caddy/Caddyfile 로 올리고 reload 한다.
#
# jiwon.knowhow-it.com 은 DNS 를 이 서버로 돌린 뒤에 인증서가 나온다(그 전에는 Caddy 가 조용히 다시 시도).
# origin.jiwon.knowhow-it.com 은 나중에 CloudFront 를 앞에 둘 때 CloudFront 가 찾아오는 주소.
#
# 점검 화면: Node(3000)가 죽거나 답이 없으면 Caddy 가 /srv/jiwon/static/maintenance.html 을 503 으로 낸다.
# 2026-10-06 서버가 멈췄을 때 맨 "502" 글자만 보였다. 503 + Retry-After 는 검색엔진에 "잠깐만" 이라는 뜻이라
# 색인이 빠지지 않는다. 파일이 없으면(옛 서버) 그냥 짧은 글로 답한다.

# CloudFront 앞단(2026-11-16). jiwon 은 CloudFront(서울 거점)를 거쳐 origin.jiwon.knowhow-it.com 으로 들어온다.
# (Cloudflare 프록시는 한국 회선이 LAX 로 가 2~3초가 걸려 쓰지 않는다. Cloudflare 는 DNS 만.)
# 연결은 모두 CloudFront 주소에서 오므로, 그대로 두면 접속 기록·속도 제한이 손님 대신 CloudFront 를 본다. 그래서:
#  - CloudFront 가 원본에 올 때 쓰는 대역(ip-ranges.json 의 CLOUDFRONT_ORIGIN_FACING, 2026-11-16 판)만 믿는다.
#  - X-Forwarded-For 는 오른쪽부터 읽어 믿지 않는 첫 주소를 손님으로 본다(trusted_proxies_strict).
#    CloudFront 는 손님 주소를 맨 뒤에 붙이고, 맨 앞은 손님이 써 넣을 수 있다.
# 대역이 늘어 목록이 낡으면 그 대역으로 온 요청의 client_ip 가 CloudFront 주소로 남는다(기록·앱 속도 제한만 부정확해지고
# 사이트는 돈다 — fail2ban 은 CloudFront 를 거친 요청을 세지 않는다). 가끔 ip-ranges.json 과 맞춘다.
{
	servers {
		trusted_proxies static 13.124.199.0/24 130.176.0.0/18 130.176.128.0/21 130.176.136.0/23 130.176.140.0/22 130.176.144.0/20 130.176.160.0/19 130.176.192.0/19 130.176.64.0/21 130.176.72.0/22 130.176.76.0/24 130.176.78.0/23 130.176.80.0/22 130.176.86.0/23 130.176.88.0/21 130.176.96.0/19 15.158.0.0/16 18.68.0.0/16 204.246.166.0/24 205.251.218.0/24 24.110.128.0/17 3.172.0.0/18 3.172.64.0/18 3.29.57.0/26 51.74.20.0/24 51.74.21.0/24 51.74.22.0/24 52.46.0.0/18 52.82.128.0/23 52.82.134.0/23 54.182.128.0/20 54.182.144.0/21 54.182.154.0/23 54.182.156.0/22 54.182.160.0/21 54.182.172.0/22 54.182.176.0/21 54.182.184.0/22 54.182.188.0/23 54.182.224.0/21 54.182.240.0/21 54.182.248.0/22 54.239.134.0/23 54.239.170.0/23 54.239.204.0/22 54.239.208.0/21 64.252.128.0/18 64.252.64.0/18 70.132.0.0/18 2600:9000:1000::/36 2600:9000:5200::/40 2600:9000:6000::/36
		trusted_proxies_strict
	}
}

# 접속 기록(2026-10-14). 전에는 오류만 남아 누가 얼마나 긁는지 알 수 없었다.
# fail2ban(deploy/lightsail/fail2ban)이 이 파일을 읽어 너무 빠른 IP 를 방화벽에서 막는다.
# 시각은 ISO8601 이라야 fail2ban 이 읽는다(기본 epoch 는 줄 중간에서 못 찾는다).
# 머리글은 이름표(User-Agent)·리퍼러·언어만 남기려고 나머지 흔한 것을 지운다. 이름표는 fail2ban 이 검색엔진을 빼는 데 쓴다.
# 쿠키·인증·기기 열쇠(X-Device-Key)는 지운다.
# 미리 받기 표시(Sec-Purpose·Purpose)는 남긴다. 구글 검색 결과의 미리 받기와 진짜 방문을 가르는 데 쓴다(2026-10-15).
# Sec-Fetch-Site 도 남긴다(2026-11-15). 진짜 브라우저는 늘 보내고 흉내 낸 수집기는 안 보낸다 —
# 브라우저 이름표로 여러 IP 에서 /jobs/N 을 훑는 요청(6분에 1,060건·IP 869개)이 사람인지 가르려는 것.
# 하루치를 보고, 이 머리글이 없는 요청에 사람이 섞이지 않으면 그때 막는다. 값만 남기고 아직 막지 않는다.
# 20MB 씩 7개, 7일 넘은 것은 지운다. IP 를 담으니 오래 두지 않는다(개인정보 처리방침 '접속 기록').
(access) {
	log {
		output file /var/log/caddy/access.log {
			roll_size 20MiB
			roll_keep 7
			roll_keep_for 168h
		}
		format filter {
			wrap json {
				time_format iso8601
			}
			fields {
				request>headers>Accept delete
				request>headers>Accept-Encoding delete
				request>headers>Cookie delete
				request>headers>Authorization delete
				request>headers>Cache-Control delete
				request>headers>Pragma delete
				request>headers>Connection delete
				request>headers>Upgrade-Insecure-Requests delete
				request>headers>Priority delete
				request>headers>Dnt delete
				request>headers>Te delete
				request>headers>Origin delete
				request>headers>Content-Type delete
				request>headers>Content-Length delete
				request>headers>If-None-Match delete
				request>headers>If-Modified-Since delete
				request>headers>Sec-Ch-Ua delete
				request>headers>Sec-Ch-Ua-Mobile delete
				request>headers>Sec-Ch-Ua-Platform delete
				request>headers>Sec-Fetch-Dest delete
				request>headers>Sec-Fetch-Mode delete
				request>headers>Sec-Fetch-User delete
				request>headers>Rsc delete
				request>headers>Next-Router-Prefetch delete
				request>headers>Next-Router-State-Tree delete
				request>headers>Next-Router-Segment-Prefetch delete
				request>headers>Next-Url delete
				request>headers>Next-Action delete
				request>headers>X-Device-Key delete
				request>headers>Baggage delete
				request>headers>Sentry-Trace delete
				# CloudFront 가 붙이는 것. 손님 주소는 client_ip 에 이미 있다.
				request>headers>X-Forwarded-For delete
				request>headers>X-Forwarded-Proto delete
				request>headers>X-Amz-Cf-Id delete
				request>headers>Via delete
				request>headers>X-Edge delete
				request>tls delete
				resp_headers delete
				user_id delete
			}
		}
	}
}

# 막는 것(Node 까지 가지 않고 Caddy 가 바로 답한다).
#  1) 스캐너: 이 사이트에 없는 PHP·워드프레스·설정 파일 주소. 404.
#  2) robots.txt 로 통째로 막은 봇(web/app/robots.txt/route.ts BLOCKED)이 그래도 오면 403. robots.txt 는 읽게 둔다.
#  3) 이름표(User-Agent)가 없는 요청. 403. 브라우저·검색엔진은 반드시 단다.
#  4) 봇이 robots.txt 로 막은 경로에 오면 403(아래 @robotsdeny).
#  5) AI 답변 봇이 공유 그림(/og)을 그려 가면 403(아래 @ogbot). robots.txt 와 같다.
#  6) 브라우저 이름표인데 Accept-Language 가 없는 쪽 요청. 403(아래 @nolang).
#  7) 스스로 봇이라 밝혔는데 허용 목록에 없는 것. 403(아래 @restbot). 새 수집 봇은 이름을 몰라도 여기서 걸린다.
#  8) 브라우저로 꾸민 수집기. 한국어가 아닌 브라우저의 "직접 연 첫 방문"에만 자바스크립트 한 번 문(아래 @scrape·@scrape2).
# 검색엔진(Googlebot·Yeti·Daum·bingbot)·AdSense·AI 답변 봇(PerplexityBot·OAI-SearchBot·Claude-User 등)은 건드리지 않는다.
# 속도 제한(fail2ban jiwon-flood)에서도 이 봇들은 뺀다(2026-11-15).
(guard) {
	@scan {
		path *.php *.asp *.aspx *.jsp *.cgi /wp-* /wordpress* /.env* /.git* /.aws* /.ssh* /.vscode* /.DS_Store
		path /cgi-bin/* /vendor/* /phpmyadmin* /pma* /boaform* /actuator* /server-status* /HNAP1* /owa/* /autodiscover* /xmlrpc*
	}
	respond @scan 404 {
		close
	}
	@badbot {
		not path /robots.txt
		header_regexp User-Agent (?i)(GPTBot|ClaudeBot|anthropic-ai|CCBot|Bytespider|PetalBot|Amazonbot|meta-externalagent|meta-webindexer|Reflectionbot|FacebookBot|cohere-ai|Diffbot|ImagesiftBot|Omgilibot|Timpibot|YouBot|AhrefsBot|SemrushBot|MJ12bot|DotBot|DataForSeoBot|BLEXBot|serpstatbot|Barkrowler|ZoominfoBot|zgrab|masscan|Nuclei|sqlmap|Nikto)
	}
	respond @badbot 403
	@noua not header User-Agent *
	respond @noua 403
	# 4) robots.txt 를 Caddy 에서 지킨다. 봇 이름표로 robots.txt 가 막은 경로(검색어 조합 /jobs/…/q/…, 검색, API, 계정, 관리자, 저장)에
	#    오면 403. 2026-10-14 meta-webindexer 가 IP 96개로 나눠 7분에 782건, 그 상당수가 /jobs/q/ 였다(IP 별 속도 제한에 안 걸림).
	#    이 경로는 쪽마다 서버 디스크에 캐시가 쌓인다(2026-10-09 3.3GB). AdSense 봇(Mediapartners·AdsBot)은 원래 공통 규칙(*)을
	#    따르지 않는 것이 정상이라 뺀다. "bot" 은 뒤에 / ) ; 가 올 때만 본다 — CUBOT 같은 휴대폰 이름이 걸리지 않게.
	@robotsdeny {
		path_regexp hidden ^/(?:search|find|api/|account|admin|saved)|^/jobs/(?:.*/)?q/
		header_regexp botua User-Agent (?i)(bot[/);]|crawler|spider|slurp|indexer|fetcher)
		not header_regexp adsua User-Agent (?i)(Mediapartners-Google|AdsBot-Google)
	}
	respond @robotsdeny 403
	#  5) 공유 그림(/og)은 robots.txt 가 AI 답변 봇에게만 막아 둔 경로다(web/app/robots.txt/route.ts ANSWER_BOTS).
	#     2026-10-16 PerplexityBot 이 그래도 12시간에 수백 번 그려 가 Next 메모리가 493MB 까지 올랐다(10-09 와 같은 일).
	#     그림 그리기는 글꼴 내려받기·렌더링이라 쪽 하나보다 훨씬 무겁다. 쪽은 계속 열어 두고 그림만 403.
	@ogbot {
		path /og /og/*
		header_regexp aibot User-Agent (?i)(PerplexityBot|OAI-SearchBot|ChatGPT-User|Google-Extended|Claude-SearchBot|Claude-User|Claude-Web)
	}
	respond @ogbot 403
	#  6) 2026-11-15 브라우저 이름표(Mozilla/…)인데 Accept-Language 가 없는 쪽 요청. 403.
	#     맥 크롬으로 꾸민 수집기가 IP 1,763개로 30분에 쪽 1,350건을 긁어(/jobs/region·/jobs/hire·/jobs/q 조합)
	#     Lightsail CPU 버스트가 바닥났고(steal 54~78%), 사람 쪽 응답이 3~46초가 됐다. 같은 한 시간에 자바스크립트를
	#     돌린 진짜 방문(/api/visit) 18건은 모두 Accept-Language 가 있었다(deploy/lightsail/lang_report.py).
	#     검색엔진·광고봇·메신저 미리보기는 이름표로 뺀다. 그림·스크립트·robots·사이트맵은 막지 않는다.
	@nolang {
		not path /_next/* /favicon* /icon* /apple-icon* /robots.txt /sitemap* /llms.txt /og /og/* /manifest* /ads.txt
		header_regexp nlua User-Agent ^Mozilla/
		# 2026-11-15 AI 답변 쪽의 "사용자가 시킨 방문"(Claude-User·Perplexity-User)은 이름표에 bot 이 없고 언어 머리글도 없어
		# 여기에 걸릴 수 있었다. 답변에 출처로 달려 손님을 보내는 요청이라 이름으로 뺀다(8번 문과 같은 목록).
		not header_regexp nlbot User-Agent (?i)(bot|crawler|spider|slurp|google|yeti|daum|naver|bing|facebookexternalhit|kakao|slack|discord|whatsapp|line/|preview|lighthouse|telegram|chatgpt|claude|perplexity|gpt|duckduck|zum)
		not header Accept-Language *
	}
	respond @nolang 403
	#  7) 2026-11-15 방문을 보내 주지 않는 수집 봇 둘은 잠깐 쉬게 한다(429). 버스트가 바닥난 44분 동안
	#     Amzn-SearchBot 276건·ElevenlabsCrawler 72건이 쪽을 긁었다(전체의 약 11%). 아마존 검색·음성 합성 쪽은
	#     우리 사이트로 사람을 보내지 않는다. OAI-SearchBot·Claude-SearchBot·PerplexityBot 은 방문을 보내므로 그대로 둔다.
	#     부하가 가라앉으면 이 규칙은 지운다.
	#     2026-11-15 고침: 이름을 하나씩 적어 막는 대신 "허용 목록"으로 바꾼다. 스스로 봇이라고 밝힌 이름표
	#     (bot/·crawler·spider·scrapy·slurp·indexer·headless)는 아래 목록에 있을 때만 들어온다. 나머지는 403.
	#     들어오는 것: 검색엔진(구글·네이버·다음·빙·덕덕고·애플·얀덱스), AI 검색·답변(OAI-SearchBot·ChatGPT-User·
	#     Perplexity·Claude-SearchBot·Claude-User), 공유 미리보기(카카오톡·페이스북·트위터·링크드인·슬랙·디스코드·텔레그램·왓츠앱·라인),
	#     광고 검수(AdSense 와 광고주 쪽 IAS·DoubleVerify·Grapeshot·Peer39·Proximic — 막으면 광고 단가가 떨어진다), 가동 감시.
	#     새 수집 봇이 생겨도 이름을 알아내 적을 필요가 없다. 열어 줄 봇이 생기면 obok 줄에 이름을 더한다.
	#     "bot" 은 뒤에 / ) ; - 가 올 때만 본다 — CUBOT 같은 휴대폰 이름이 걸리지 않게. robots.txt 는 읽게 둔다.
	@restbot {
		not path /robots.txt
		header_regexp restua User-Agent (?i)(bot[/);-]|crawler|spider|scrapy|slurp|indexer|headless)
		not header_regexp obok User-Agent (?i)(google|bing|yeti|naver|daum|kakao|duckduck|applebot|yandex|oai-searchbot|chatgpt|perplexity|claude-searchbot|claude-user|facebookexternalhit|twitterbot|linkedinbot|slack|discord|telegram|whatsapp|line/|pinterest|uptime|zum|ias_crawler|integralads|doubleverify|grapeshot|peer39|proximic|adstxt|admantx)
	}
	respond @restbot 403
	#  8) 2026-11-15 브라우저로 꾸며 상세 쪽만 훑는 수집기. 사람은 통과하는 "자바스크립트 한 번" 문.
	#     새 서버로 옮긴 직후 10분 동안 쪽 요청 1,617건 중 1,545건이 IP 1,397개에서 왔다. 그 가운데 자바스크립트·CSS 를
	#     받아 간 IP 는 하나뿐이고(그 하나가 ko-KR 로 72쪽을 본 진짜 방문), 나머지는 전부 같은 꼴이었다:
	#     Accept-Language 가 en-US, 리퍼러 없음, Sec-Fetch-Site: none, 주소는 /jobs/번호·/p/번호 차례대로. 서버 시간의 75%.
	#     6)의 "언어 머리글 없음"을 피하려고 언어를 붙여 온 같은 수집기다.
	#     막는 조건을 좁게 잡는다 — 다섯 가지가 모두 맞을 때만: 상세 쪽 주소 · 브라우저 이름표(검색·AI·미리보기 봇 아님) ·
	#     언어 en-US · 리퍼러 없음 · Sec-Fetch-Site none · jw_h 쿠키 없음. 검색 결과·ChatGPT·다른 쪽에서 눌러 온 사람은
	#     리퍼러가 있거나 cross-site 라 걸리지 않고, 한국어 브라우저도 걸리지 않는다.
	#     걸린 사람(영어 브라우저로 주소를 직접 연 경우)은 아래 짧은 HTML 이 쿠키를 심고 같은 주소를 다시 열어 바로 본다.
	#     수집기는 자바스크립트를 돌리지 않아 여기서 멈춘다. 응답은 403 — 200 으로 내면 검색엔진이 쪽 내용으로 볼 수 있다.
	#     첫 화면·목록·검색·지도·글은 조건에 넣지 않았다. 되돌리려면 이 묶음만 지운다.
	#     2026-11-15 넓힘. 문을 단 뒤에도 같은 수집기가 서버까지 닿았다(최근 6천 줄: 403 280건, 통과 364건 — 모두 IP 하나에 한 건).
	#     통과한 것은 상세 쪽이 아닌 목록·첫 화면이거나, 리퍼러를 꾸며 붙인 요청이었다(Sec-Fetch-Site: none 인데 리퍼러가 있는 것은
	#     진짜 브라우저에서 나올 수 없는 조합이다). 그래서 조건을 이렇게 바꾼다:
	#       쪽 요청(GET, 정적 파일·API 아님) · 브라우저 이름표(허용 봇 아님) · 언어가 한국어가 아님 ·
	#       Sec-Fetch-Site 가 none 이거나 아예 없음(@scrape2) · jw_h 쿠키 없음.
	#     한국어 브라우저는 어떤 경우에도 걸리지 않는다. 검색 결과·ChatGPT 에서 눌러 온 사람은 cross-site 라 걸리지 않는다.
	#     걸리는 사람은 "한국어가 아닌 브라우저로 주소를 직접 연 첫 방문"뿐이고, 한 번 다시 열린 뒤 30일 동안 그대로 본다.
	@scrape {
		method GET
		not path /_next/* /favicon* /icon* /apple-icon* /robots.txt /sitemap* /llms.txt /og /og/* /manifest* /ads.txt /api/* *.png *.jpg *.svg *.ico *.xml *.txt *.webp
		header_regexp scua User-Agent ^Mozilla/
		not header_regexp scbot User-Agent (?i)(bot|crawler|spider|slurp|google|yeti|daum|naver|bing|facebookexternalhit|kakao|slack|discord|whatsapp|line/|preview|lighthouse|telegram|chatgpt|claude|perplexity|gpt|applebot|duckduck|zum|uptime|ias_crawler|integralads|doubleverify|grapeshot|peer39|proximic)
		not header_regexp sclang Accept-Language (?i)^ko
		header Sec-Fetch-Site none
		not header_regexp scck Cookie jw_h=1
	}
	@scrape2 {
		method GET
		not path /_next/* /favicon* /icon* /apple-icon* /robots.txt /sitemap* /llms.txt /og /og/* /manifest* /ads.txt /api/* *.png *.jpg *.svg *.ico *.xml *.txt *.webp
		header_regexp scua2 User-Agent ^Mozilla/
		not header_regexp scbot2 User-Agent (?i)(bot|crawler|spider|slurp|google|yeti|daum|naver|bing|facebookexternalhit|kakao|slack|discord|whatsapp|line/|preview|lighthouse|telegram|chatgpt|claude|perplexity|gpt|applebot|duckduck|zum|uptime|ias_crawler|integralads|doubleverify|grapeshot|peer39|proximic)
		not header_regexp sclang2 Accept-Language (?i)^ko
		not header Sec-Fetch-Site *
		not header_regexp scck2 Cookie jw_h=1
	}
	header @scrape2 Content-Type "text/html; charset=utf-8"
	header @scrape2 Cache-Control "no-store"
	respond @scrape2 `<!doctype html><html lang="ko"><meta charset="utf-8"><meta name="robots" content="noindex"><title>K나라지원</title><script>document.cookie="jw_h=1; path=/; max-age=2592000; SameSite=Lax";location.replace(location.href)</script><noscript><p>이 쪽을 보려면 자바스크립트를 켜 주세요. <a href="/">K나라지원 첫 화면으로</a></p></noscript></html>` 403
	header @scrape Content-Type "text/html; charset=utf-8"
	header @scrape Cache-Control "no-store"
	respond @scrape `<!doctype html><html lang="ko"><meta charset="utf-8"><meta name="robots" content="noindex"><title>K나라지원</title><script>document.cookie="jw_h=1; path=/; max-age=2592000; SameSite=Lax";location.replace(location.href)</script><noscript><p>이 쪽을 보려면 자바스크립트를 켜 주세요. <a href="/">K나라지원 첫 화면으로</a></p></noscript></html>` 403
}

(proxy_base) {
	# 앱의 속도 제한(web/lib/rateLimit.ts)이 읽는 손님 주소. X-Forwarded-For 맨 앞은 손님이 써 넣을 수 있어
	# 앞단을 거치면 속일 수 있다. Caddy 가 정한 client_ip 로 덮어쓴다.
	header_up X-Real-IP {client_ip}
	# 앱은 늘 공개 주소로 들어온 것으로 안다. CloudFront 는 origin.… 이름으로 오는데, 그대로 넘기면
	# 미들웨어의 308(web/middleware.ts redirect308)이 손님을 origin.… 으로 보낸다.
	header_up Host jiwon.knowhow-it.com
	header_up X-Forwarded-Host jiwon.knowhow-it.com
	transport http {
		dial_timeout 3s
		# /api/cron/* 는 한 번에 최대 60초(maxDuration) 일한다. 40초로 두었을 때 큐넷 수집이 40초 만에 끊겨
		# 점검 화면이 돌아갔다(2026-10-06). Node 가 60초에 스스로 끊으니 그보다 길게.
		response_header_timeout 90s
	}
}

(app) {
	import guard
	encode zstd gzip
	# 2026-11-24 쪽 요청에서 Next 가 5xx(일시적 DB 실패 등)를 내면 점검 화면 503 + Retry-After 로 바꾼다.
	# 200 짜리 오류 화면이 색인되거나(10/6~10/10) noindex 로 굳는 일(11/13)을 막는다 — 구글은 503 을
	# "잠깐 쉬는 중"으로 읽는다. 없는 쪽은 Next 가 404 를 그대로 낸다. API·정적 파일은 원래 응답을 그대로 넘긴다
	# (크론·방문 집계가 오류 내용을 읽어야 한다).
	@page not path /api/* /_next/*
	handle @page {
		reverse_proxy 127.0.0.1:3000 {
			import proxy_base
			@up5xx status 5xx
			handle_response @up5xx {
				error 503
			}
		}
	}
	handle {
		reverse_proxy 127.0.0.1:3000 {
			import proxy_base
		}
	}
	handle_errors {
		@down expression `{err.status_code} in [502, 503, 504]`
		handle @down {
			header Retry-After 120
			header Cache-Control "no-store"
			root * /srv/jiwon/static
			@has file /maintenance.html
			handle @has {
				rewrite * /maintenance.html
				file_server {
					status 503
				}
			}
			respond "잠시 서버를 점검하고 있습니다. 몇 분 뒤 다시 열어 주세요." 503
		}
	}
}

# CloudFront 가 찾아오는 주소(2026-11-16). DNS 는 이 서버를 바로 가리켜(A 3.34.85.98) Caddy 가 인증서를 스스로 갱신한다.
# CloudFront 는 원본 요청에 X-Edge: cf-jiwon 을 붙인다(배포의 원본 사용자 지정 헤더). 그것 없이 바로 온 요청은
# 같은 내용을 주되 검색엔진에는 숨긴다 — origin.… 이 jiwon 의 복제 사이트로 색인되지 않게. 비밀이 아니라 표시일 뿐이다.
# 길게 걸리는 작업(/api/cron/orgsites·probe, 90~120초)은 CloudFront(원본 응답 60초 한도)를 거치지 않고 이 주소를 바로 부른다.
origin.jiwon.knowhow-it.com {
	@direct not header X-Edge cf-jiwon
	header @direct X-Robots-Tag "noindex, nofollow"
	import access
	import app
}

# 옛 길: jiwon 이 이 서버를 바로 가리키던 때의 것. DNS 가 CloudFront 로 넘어간 뒤에는 인증서 갱신이 되지 않으니
# (HTTP-01 이 CloudFront 로 간다) 전환이 자리 잡으면 지운다. 되돌릴 때를 위해 잠시 둔다.
jiwon.knowhow-it.com {
	import access
	import app
}

# 도메인을 돌리기 전 점검용: http://<서버 IP>/ 로 들어온 요청. 검색엔진에는 숨긴다.
:80 {
	header X-Robots-Tag "noindex, nofollow"
	import access
	import app
}
